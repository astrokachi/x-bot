// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TweetStatus {
  DRAFT
  SENT
  SCHEDULED
}

enum ChatType {
  SINGLE
  MULTIPLE
}

enum ScheduledTweetStatus {
  PENDING
  POSTED
  FAILED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String?
  password_hash String?
  name          String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  x_account     XAccount?
}

model XAccount {
  id               String    @id @default(uuid())
  user_id          String    @unique
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  access_token     String
  refresh_token    String?
  token_expires_at DateTime?
  connected_at     DateTime  @default(now())
}

model Tweet {
  id            String      @id @default(uuid())
  content       String
  status        TweetStatus
  dateScheduled DateTime
  img           String?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @default(now())
}

model Conversation {
  id         String   @id @default(uuid())
  user_id    String
  created_at DateTime
  chats      Chat[]
  summary    Summary?
}

model Chat {
  id              String       @id @default(uuid())
  prompt          String
  response        Response[]
  user_id         String
  conversation_id String
  conversation    Conversation @relation(fields: [conversation_id], references: [id])
  summary         Summary?
}

model Response {
  id         String   @id @default(uuid())
  content    String
  chat_id    String
  chat       Chat     @relation(fields: [chat_id], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model Summary {
  id              String       @id @default(uuid())
  content         String
  last_chat_id    String       @unique
  conversation_id String       @unique
  conversation    Conversation @relation(fields: [conversation_id], references: [id])
  chat            Chat         @relation(fields: [last_chat_id], references: [id])
  created_at      DateTime     @default(now())
  updated_at      DateTime     @default(now())
}
