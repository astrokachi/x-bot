// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TweetStatus {
  DRAFT
  POSTED
  FAILED
}

enum ScheduledTweetStatus {
  PENDING
  POSTED
  FAILED
}

enum SentimentType {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum AutoReplyStatus {
  PENDING
  APPROVED
  REJECTED
  POSTED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String?
  password_hash String?
  name          String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  x_account           XAccount?
  tweets              Tweet[]
  replies             Reply[]
  scheduled_tweets    ScheduledTweet[]
  keyword_alerts      KeywordAlert[]
  comment_filters     CommentFilter[]
  pending_replies     PendingAutoReply[]
  auto_reply_settings AutoReplySettings?
  analytics_events    AnalyticsEvent[]

  @@index([email])
}

model XAccount {
  id               String    @id @default(uuid())
  user_id          String    @unique
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  access_token     String
  refresh_token    String?
  token_expires_at DateTime?
  connected_at     DateTime  @default(now())
}

model Tweet {
  id           String      @id @default(uuid())
  user_id      String
  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  content      String
  status       TweetStatus @default(DRAFT)
  x_tweet_id   String?
  image_key    String?
  posted_at    DateTime?
  scheduled_at DateTime?
  created_at   DateTime    @default(now())

  @@index([user_id])
  @@index([status])
}

model Reply {
  id                String    @id @default(uuid())
  user_id           String
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tweet_url         String
  x_tweet_id        String?
  generated_replies Json?
  selected_reply    String?
  x_reply_id        String?
  image_key         String?
  posted_at         DateTime?
  created_at        DateTime  @default(now())

  @@index([user_id])
}

model ScheduledTweet {
  id             String               @id @default(uuid())
  user_id        String
  user           User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  content        String
  image_key      String?
  scheduled_time DateTime
  timezone       String?
  status         ScheduledTweetStatus @default(PENDING)
  bullmq_job_id  String?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt

  @@index([user_id])
  @@index([status])
  @@index([scheduled_time])
}

model KeywordAlert {
  id         String         @id @default(uuid())
  user_id    String
  user       User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  keyword    String
  enabled    Boolean        @default(true)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
  matches    KeywordMatch[]

  @@index([user_id])
  @@index([keyword])
}

model KeywordMatch {
  id                String       @id @default(uuid())
  keyword_alert_id  String
  keyword_alert     KeywordAlert @relation(fields: [keyword_alert_id], references: [id], onDelete: Cascade)
  matched_tweet_url String
  matched_content   String
  matched_at        DateTime     @default(now())
}

model CommentFilter {
  id             String        @id @default(uuid())
  user_id        String
  user           User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  keyword        String
  sentiment_type SentimentType
  enabled        Boolean       @default(true)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  @@index([user_id])
  @@index([keyword])
}

model PendingAutoReply {
  id                String          @id @default(uuid())
  user_id           String
  user              User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  comment_url       String
  comment_content   String
  generated_replies Json?
  status            AutoReplyStatus @default(PENDING)
  created_at        DateTime        @default(now())

  @@index([user_id])
}

model AutoReplySettings {
  id                String   @id @default(uuid())
  user_id           String   @unique
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  approval_required Boolean  @default(true)
  daily_limit       Int      @default(10)
  enabled           Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([user_id])
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event_type String
  metadata   Json?
  created_at DateTime @default(now())

  @@index([user_id])
}
